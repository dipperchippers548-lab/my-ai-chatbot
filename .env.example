# VANTAGE 4o - Environment variables (copy to .env and fill in)
# Never commit .env to version control.

# Required: JWT signing secret (use a long random string in production)
JWT_SECRET=your-secret-key-change-in-production

# Optional: override auth cookie name
# AUTH_COOKIE_NAME=vantage_token

# Optional: SQLite database path (default: ./data/vantage.db)
# DATABASE_PATH=./data/vantage.db

# Groq API key (for AURA chat)
GROQ_API_KEY=your-groq-api-key

# Stripe (placeholder; add when enabling payments)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Node environment (production | development)
# NODE_ENV=development
